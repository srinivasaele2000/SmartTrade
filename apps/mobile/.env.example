# Set explicitly for the device you use. EXPO_PUBLIC values are embedded in the app;
# never place credentials or tokens here.
EXPO_PUBLIC_API_URL=

# Optional demo switcher. Use only reserved, controlled test phone numbers.
EXPO_PUBLIC_ENABLE_DEMO_ROLES=false
EXPO_PUBLIC_DEMO_BUYER_MOBILE=
EXPO_PUBLIC_DEMO_DEALER_MOBILE=
EXPO_PUBLIC_DEMO_COMPANY_MOBILE=
EXPO_PUBLIC_DEMO_STAFF_MOBILE=
EXPO_PUBLIC_DEMO_SERVICE_PROVIDER_MOBILE=
EXPO_PUBLIC_DEMO_JOB_SEEKER_MOBILE=
EXPO_PUBLIC_DEMO_EMPLOYER_MOBILE=
# Android emulator: http://10.0.2.2:8000/api/v1
# Android USB with adb reverse tcp:8000 tcp:8000: http://127.0.0.1:8000/api/v1
# iOS simulator on the same Mac as API: http://127.0.0.1:8000/api/v1
