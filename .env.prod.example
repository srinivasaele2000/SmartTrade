# Copy to .env.prod on the VPS. Replace both secret placeholders before starting.
DJANGO_SECRET_KEY=replace-with-a-generated-production-secret
POSTGRES_DB=smarttrade
POSTGRES_USER=smarttrade
POSTGRES_PASSWORD=replace-with-a-generated-database-password

ALLOWED_HOSTS=189.72.155.44
CORS_ALLOWED_ORIGINS=http://189.72.155.44
CSRF_TRUSTED_ORIGINS=http://189.72.155.44
USE_HTTPS=false

# Configure providers only when the deployment is ready for authenticated use.
SMARTTRADE_OTP_PROVIDER=
SMARTTRADE_COMPANY_EMAIL_PROVIDER=
SMARTTRADE_COMPANY_DOCUMENT_MAX_BYTES=
SMARTTRADE_COMPANY_DOCUMENT_ALLOWED_TYPES=
SMARTTRADE_COMPANY_REQUIRED_DOCUMENT_TYPES=

# Optional vision extraction. Set openai, gemini or auto to send pages to the configured provider.
CATALOGUE_AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_CATALOGUE_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_CATALOGUE_MODEL=gemini-2.5-flash
