FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev tesseract-ocr tesseract-ocr-eng poppler-utils libgl1 libglib2.0-0 \
    libjpeg62-turbo zlib1g libwebp7 libgomp1 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements.prod.txt ./
RUN pip install -r requirements.prod.txt
COPY . .

RUN groupadd --gid 10001 smarttrade \
    && useradd --uid 10001 --gid 10001 --no-create-home smarttrade \
    && install -d -o smarttrade -g smarttrade /data/static /data/private /data/catalogue /data/public-media

USER 10001:10001
EXPOSE 8000
CMD ["sh", "-ec", "python manage.py migrate --noinput && python manage.py collectstatic --noinput && chmod -R a+rX /data/static && exec gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 3 --timeout \"${GUNICORN_TIMEOUT:-120}\" --access-logfile - --error-logfile -"]
