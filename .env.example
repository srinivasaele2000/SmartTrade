DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=postgresql
DB_NAME=smarttrade
DB_USER=smarttrade
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
API_PORT=8000
SMARTTRADE_OTP_PROVIDER=
SMARTTRADE_COMPANY_EMAIL_PROVIDER=
SMARTTRADE_COMPANY_DOCUMENT_MAX_BYTES=
SMARTTRADE_COMPANY_DOCUMENT_ALLOWED_TYPES=
SMARTTRADE_COMPANY_REQUIRED_DOCUMENT_TYPES=
PRIVATE_FILE_STORAGE_ROOT=
POSTGRES_DB=smarttrade
POSTGRES_USER=smarttrade
POSTGRES_PASSWORD=

# Local development only; select an existing active STAFF account explicitly.
SMARTTRADE_ENABLE_DEV_AUTH=false
SMARTTRADE_DEV_AUTH_STAFF_ID=

# Local simulation only: never verifies ownership of a phone number.
SMARTTRADE_ENABLE_DEV_OTP=false

# Local company email simulation; requires DEBUG and loopback requests.
SMARTTRADE_ENABLE_DEV_EMAIL=false
